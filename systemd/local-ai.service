[Unit]
Description=Local AI - llama.cpp SYCL on Intel Arc B580
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/.local/bin/local-ai-server
Restart=on-failure
RestartSec=20
TimeoutStopSec=60
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
